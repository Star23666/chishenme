.page {
  min-height: 100vh;
  padding: 0;
}

/* ---------- 分段 ----------
   ★ 这一页原来是 8 个白底圆角卡片叠在一起，是「卡片堆叠」最集中的地方。
     .card 的底色和圆角已经在 app.wxss 里去掉了（改成「一段内容」），
     这里只补一根发丝线收口 —— 分段靠线，不靠盒子。 */
.card {
  border-bottom: 1rpx solid var(--c-line);
}

/* 左右留白收窄过一版（30rpx → 20rpx），目的只有一个：
   把输入框从 325px 撑到 339px（375px 屏）。
   现在输入框没有边框了，留白统一到全站的 30rpx 主线。 */
.pad {
  margin: 0;
  padding: 32rpx var(--gutter);
}

.t1 {
  font-family: var(--f-serif);
  font-size: var(--t-h1);
  font-weight: 700;
  color: var(--c-ink);
}

.t2 {
  font-size: var(--t-sub);
  color: var(--c-ink-2);
  line-height: 1.75;
  margin-top: 16rpx;
}

.t3 {
  font-size: var(--t-cap);
  color: var(--c-ink-3);
  margin-top: 24rpx;
  line-height: 1.6;
}

.strong {
  color: var(--c-ink);
  font-weight: 600;
}

/* 等宽字体留给「要照着敲的标识符」（config.js / csm_menus / 房间码）——
   这是等宽字体唯一真有用的地方，不做小标签装饰。
   ★ 颜色从主色改成灶红：主色当字用只有 2.45:1。 */
.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: var(--t-cap);
  color: var(--c-brand-ink);
}

/* ---------- 未配云开发时的步骤清单 ----------
   这里是**真的步骤**（1→2→3→4 有先后），所以编号是正当的：
   它承载顺序信息，不是「01 / 02 / 03」那种装饰性序号。
   形状从圆点改成方框，跟全站的直角语言一致。 */
.steps {
  margin-top: 24rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  font-size: var(--t-sub);
  color: var(--c-ink-2);
  line-height: 1.7;
  padding: 16rpx 0;
}

.step-n {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border: 1rpx solid var(--c-brand);
  border-radius: 4rpx;
  color: var(--c-brand-ink);
  font-family: var(--f-serif);
  font-size: var(--t-tag);
  font-weight: 700;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

/* ---------- 邀请提示 ----------
   ★ 一整块淡橙底「卡片」→ 一条带主色左竖线的提示。
     同一套语言在菜单页的 22:30 提示条上也用（sunk 底 + 左竖线）。 */
.invite {
  background: var(--c-surface-sunk);
  border-left: 6rpx solid var(--c-brand);
  border-radius: var(--r-btn);
  margin: 24rpx var(--gutter) 0;
  padding: 24rpx;
}

.invite-title {
  font-family: var(--f-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
}

.invite-sub {
  font-size: var(--t-sub);
  color: var(--c-ink-2);
  margin-top: 16rpx;
  line-height: 1.7;
}

.warn {
  font-size: var(--t-sub);
  color: var(--c-danger);
  line-height: 1.7;
  margin-top: 16rpx;
}

.warn-inline {
  color: var(--c-danger);
}

/* ---------- 两个 tab ----------
   ★ 从「灰底胶囊轨道 + 白色浮起的选中块」改成下划线式 ——
     和菜库的分类条同一套语言。这一页没有别的选择器，不会混淆。
     全站的胶囊只留在摇一摇那个「随机一道 / 三菜一汤」上。 */
.tabs {
  display: flex;
  margin: 24rpx var(--gutter) 0;
  background: transparent;
  border-radius: 0;
  padding: 0;
  border-bottom: 1rpx solid var(--c-line);
}

/* box-sizing 不能省：选中态多一根 6rpx 的下划线，
   不写的话切换时整行会跳。 */
.tab {
  flex: 1;
  box-sizing: border-box;
  text-align: center;
  font-size: var(--t-body);
  color: var(--c-ink-2);
  padding: 24rpx 0;
  border-bottom: 6rpx solid transparent;
  margin-bottom: -1rpx;
}

.tab.on {
  background: transparent;
  border-bottom-color: var(--c-brand);
  color: var(--c-ink);
  font-weight: 600;
}

/* ---------- 表单 ---------- */

.label {
  font-size: var(--t-sub);
  color: var(--c-ink-3);
  margin: 32rpx 0 4rpx;
}

/* ★★★ height 这一行绝对不要删 —— 这是本项目最隐蔽的一个坑。

   微信 <input> 的基础库默认样式是：
     input { display: block; height: 1.4rem; min-height: 1.4rem;
             overflow: hidden; white-space: nowrap; }
   而下面写了 box-sizing: border-box，于是「上下 padding」是要在 22.4px 里扣的：
     24rpx(12px) × 2 = 24px  >  22.4px   →   内容区被挤成负值  →  **输入的文字整行被裁掉**

   症状极具迷惑性：**开发者工具模拟器一切正常，只有真机上看不到自己输入的字**
   （浏览器里 <input> 没有默认高度，所以复刻渲染也量不出来）。自动检查同样查不到。

   正确做法：显式写 height，垂直居中交给组件自身，**不要再写上下 padding**。
   wxml-check.js 里有断言锁住这条。 */

/* ★ 灰底圆角输入框 → 纸上一根线。
   填表本来就是「在纸上写字」，一根线比一个盒子更直接；
   线也顺便替掉了 18 处白底容器里属于表单的那几个。 */
.inp {
  background: transparent;
  border: none;
  border-bottom: 2rpx solid var(--c-line-strong);
  border-radius: 0;
  height: 104rpx;
  padding: 0;
  font-size: var(--t-h2);
  color: var(--c-ink);
  width: 100%;
  box-sizing: border-box;
}

/* 房间码是这一页最需要「被认出来」的输入框。
   ★ 原来是淡橙底 + 淡橙边；现在底没了，改用**一根更粗的主色线** ——
     主色做线（面），不做填充块，符合全站的主色用法。 */
.code-input {
  font-family: var(--f-serif);
  font-size: var(--t-display);
  font-weight: 700;
  letter-spacing: 10rpx;
  text-align: center;
  color: var(--c-brand-ink);
  background: transparent;
  border-bottom: 6rpx solid var(--c-brand);
}

.pre {
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  margin-top: 16rpx;
  line-height: 1.6;
}

.pre-bad {
  color: var(--c-danger);
}

.hint {
  font-size: var(--t-cap);
  color: var(--c-ink-3);
  line-height: 1.7;
  margin-top: 24rpx;
}

/* 表单主按钮：输入框高 52px，按钮也加高到 46px，两边对齐，别头重脚轻。
   只在本页覆盖，不动 app.wxss 的全局按钮。 */
.card .btn-primary {
  margin-top: 40rpx;
  padding: 32rpx 0;
}

/* ---------- 房间头 ----------
   ★ 原来是一整块主色橙 + 白字 + 白色码牌。
     「整块主色」是全站最重的一种刷法，用在这里等于把页面钉成了一张横幅。
     现在它回到纸上：宋体的房间名 + 一句小字 + **一枚印章装房间码**。
     印章是全站唯一的「装饰」，但它带信息（房号就是进房间的钥匙），
     而且和分享页上的那枚是同一个形状 —— 一眼认得出是同一件东西。 */
.room {
  background: transparent;
  margin: 0;
  padding: 32rpx var(--gutter) 24rpx;
  text-align: left;
}

.room-name {
  font-family: var(--f-serif);
  font-size: var(--t-display);
  font-weight: 700;
  color: var(--c-ink);
}

.room-sub {
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  margin-top: 8rpx;
}

.code-badge {
  display: inline-block;
  margin: 24rpx 0 8rpx;
  padding: 16rpx var(--gutter) 24rpx;
  border: 3rpx solid var(--c-brand-ink);
  border-radius: 4rpx;
  transform: rotate(-2.5deg);
  font-family: var(--f-serif);
  font-size: var(--t-big);
  font-weight: 700;
  letter-spacing: 10rpx;
  color: var(--c-brand-ink);
  background: transparent;
}

.room-ops {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

/* 次要动作：★ 从「橙色块上的白色描边药丸」改成描边方角小按钮。
   一屏里唯一的实心块留给下面的「去看今天的菜单」。 */
.op {
  margin: 0 8rpx 0 0;
  padding: 16rpx 32rpx;
  border-radius: var(--r-btn);
  border: 1rpx solid var(--c-line-strong);
  color: var(--c-ink-2);
  font-size: var(--t-cap);
  text-align: center;
  line-height: 1.4;
}

.op-share {
  background: transparent;
  border-color: var(--c-brand-line);
  color: var(--c-brand-ink);
}

.op-share::after {
  border: none;
}

/* ---------- 我的称呼 ---------- */
.me-bar {
  display: flex;
  align-items: center;
  padding: 32rpx var(--gutter);
}

.me-left {
  flex: 1;
  min-width: 0;
}

.me-lbl {
  font-size: var(--t-tag);
  color: var(--c-ink-3);
}

.me-name {
  font-family: var(--f-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
  margin-top: 8rpx;
}

/* ★ 淡橙底药丸 → 文字链 */
.me-op {
  flex-shrink: 0;
  font-size: var(--t-cap);
  color: var(--c-brand-ink);
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid var(--c-brand);
  padding: 0 0 4rpx;
}

/* ---------- 成员列表 ----------
   名册的样子：方角的格 + 一个字 + 名字。圆头像更像社交产品，
   而这一页是「家里有哪几口人」。 */
.mems {
  margin: 0;
  padding: 0 var(--gutter);
}

.mem {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.mem:last-child {
  border-bottom: none;
}

.mem-avatar {
  width: 62rpx;
  height: 62rpx;
  line-height: 60rpx;
  text-align: center;
  border: 1rpx solid var(--c-line-strong);
  border-radius: 4rpx;
  background: transparent;
  color: var(--c-ink-2);
  font-family: var(--f-serif);
  font-size: var(--t-body);
  font-weight: 600;
  flex-shrink: 0;
}

.mem-name {
  flex: 1;
  min-width: 0;
  padding: 0 24rpx;
  font-size: var(--t-h2);
  color: var(--c-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 小标：药丸 → 方角描边。
   ★ 「我」原来是白字压橙底（2.74:1，不达标），改成灶红字 + 主色边。 */
.mem-tag {
  flex-shrink: 0;
  font-size: var(--t-tag);
  color: var(--c-ink-3);
  border: 1rpx solid var(--c-line-strong);
  border-radius: 4rpx;
  padding: 4rpx 12rpx;
}

.mem-tag-me {
  color: var(--c-brand-ink);
  border-color: var(--c-brand);
  background: transparent;
}

/* ---------- 房间内操作 ---------- */
.ops2 {
  margin: 32rpx 0 0;
  padding: 8rpx var(--gutter) 40rpx;
}

.btn-ghost {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--t-body);
  color: var(--c-danger);
  padding: 24rpx 0;
}

/* 解散房间：不可逆，而且家里其他人什么都没点就被牵连。
   所以让它比旁边那个「退出房间」（纯文字链接）多一层实体。
   形状跟着全站走直角，不再是药丸。 */
.btn-danger {
  background: var(--c-danger-tint);
  border-radius: var(--r-btn);
  font-weight: 600;
}
