<!-- 收藏：长按菜库卡片收藏的菜都在这儿 -->
<view class="page">

  <view class="empty" wx:if="{{empty}}">
    <view class="empty-title">还没有收藏的菜</view>
    <view class="empty-desc">去「菜库」长按任意菜品，<br />就能把它收进这里，下次一眼找到</view>
    <view class="empty-btns">
      <view class="eb" bindtap="goLibrary">去菜库逛逛</view>
    </view>
  </view>

  <block wx:else>
    <view class="section-title">已收藏 {{list.length}} 道 · 全库共 {{total}} 道</view>
    <view class="grid">
      <view class="fcard" wx:for="{{list}}" wx:key="id">
        <image class="fc-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="fc-name">{{item.name}}</view>
        <view class="fc-sub">{{item.catName}} · {{item.main}}</view>
        <view class="fc-ops">
          <view class="fc-btn" data-id="{{item.id}}" bindtap="unFav">取消收藏</view>
          <view class="fc-btn fc-add" data-id="{{item.id}}" bindtap="add">
            {{item.qty > 0 ? '再来一份' : '加入菜单'}}
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="safe-bottom"></view>
</view>
