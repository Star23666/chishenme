.page {
  min-height: 100vh;
}

/* ---------- 收藏清单 ----------
   ★ 原来是「白卡 + 两个药丸按钮」的双列网格 —— 卡片和按钮一起堆，
     是最像后台的一页。
     现在改成**一行一道**：小方图 + 菜名/分类主料 + 两个文字链动作。
     一屏能看到更多道，动作也不再抢眼。 */
.grid {
  display: block;
  padding: 0 var(--gutter);
}

.fcard {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin: 0;
  padding: 24rpx 0;
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid var(--c-line);
  overflow: visible;
}

.fcard:last-child {
  border-bottom: none;
}

.fc-img {
  width: 118rpx;
  height: 118rpx;
  flex-shrink: 0;
  display: block;
  border-radius: var(--r-thumb);
  background: var(--c-surface-sunk);
}

.fc-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.fc-name {
  font-family: var(--f-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
  padding: 0;
}

.fc-sub {
  font-size: var(--t-tag);
  color: var(--c-ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ★ 两个药丸 → 两条文字链。动作降级了，但间距留够，手指照样好点。 */
.fc-ops {
  display: flex;
  align-items: center;
  padding: 16rpx 0 4rpx;
}

/* 两个文字链：视觉全部来自 app.wxss 的 .tx / .tx-brand，这里只管间距 */
.fc-ops .tx + .tx {
  margin-left: 40rpx;
}

/* 计数那行：整句话，不用带短横的分区标题（那个只适合「分组名」） */
.fav-count {
  padding: 24rpx var(--gutter) 8rpx;
  font-size: var(--t-cap);
  color: var(--c-ink-3);
}

.fav-count .n {
  font-family: var(--f-serif);
  font-size: var(--t-cap);
  color: var(--c-ink);
}
