.page {
  min-height: 100vh;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.fcard {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  background: var(--c-surface);
  border-radius: var(--r-card);
  overflow: hidden;
}

.fc-img {
  width: 100%;
  height: 300rpx;
  display: block;
  background: var(--c-surface-sunk);
}

.fc-name {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
  padding: 16rpx 20rpx 0;
}

.fc-sub {
  font-size: var(--t-tag);
  color: var(--c-ink-3);
  padding: 6rpx 20rpx 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fc-ops {
  display: flex;
  padding: 18rpx 20rpx 22rpx;
}

.fc-btn {
  flex: 1;
  text-align: center;
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  background: var(--c-surface-sunk);
  border-radius: var(--r-pill);
  padding: 14rpx 0;
  margin-right: 12rpx;
}

.fc-btn:last-child {
  margin-right: 0;
}

.fc-add {
  background: var(--c-brand);
  color: #FFFFFF;
}
