.page {
  min-height: 100vh;
}

/* ---------- 照片 ----------
   ★ 原来是「通栏灰底块」。现在留出边距 + 走全站的缩略图圆角，
     读起来是「纸上贴了一张照片的位置」，而不是一条横幅。
     没图时是一块安静的下沉面加一个「＋」，不加边框 —— 避免「卡里套卡」。 */
.photo {
  position: relative;
  margin: 26rpx 30rpx 0;
  height: 420rpx;
  border-radius: var(--r-thumb);
  background: var(--c-surface-sunk);
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-mark {
  font-size: 72rpx;
  line-height: 1;
  color: var(--c-ink-4);
  font-weight: 300;
}

.photo-hint {
  margin-top: 18rpx;
  font-size: var(--t-cap);
  color: var(--c-ink-3);
}

/* 「换一张」压在照片右下角。半透明黑底是唯一一处需要压住照片的地方，
   用纯黑 + 透明度而不是主色，免得跟主按钮抢注意力。 */
.photo-redo {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 12rpx 26rpx;
  border-radius: var(--r-btn);
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: var(--t-cap);
}

/* ---------- 表单 ----------
   ★ 去掉白底和上边框。填表本来就是「在纸上写字」，
     而每一行底下的那根线就是「写字的横格」——
     线已经承担了结构，不需要再给它套一个白盒子。 */
.form {
  margin-top: 22rpx;
  background: transparent;
  border-top: none;
  padding: 0 30rpx;
}

.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0;
  border-bottom: 1rpx solid var(--c-line);
}

.row-cat,
.row-area {
  align-items: flex-start;
  padding-top: 26rpx;
  padding-bottom: 26rpx;
}

.k {
  width: 110rpx;
  flex-shrink: 0;
  font-size: var(--t-sub);
  color: var(--c-ink-3);
}

/*
 * ★ 微信 <input> 的基础库默认样式是 height:1.4rem / min-height:1.4rem。
 *   这里写了 box-sizing:border-box，就**必须**显式给 height，
 *   否则一旦再叠加上下 padding，内容区会被算成负值 ——
 *   真机上整行字都看不见（模拟器和浏览器复刻都正常，极难排查）。
 *   所以这里只给 height，垂直居中交给组件自己。
 */
.input {
  flex: 1;
  height: 100rpx;
  box-sizing: border-box;
  font-size: var(--t-body);
  color: var(--c-ink);
  background: transparent;
}

/* ★ 分类 chip：药丸 → 方角描边；选中是主色实心 + 墨字（白字压橙 2.74:1 不达标）。 */
.chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.chip {
  margin: 0 14rpx 14rpx 0;
  padding: 10rpx 26rpx;
  border: 1rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
  background: transparent;
  color: var(--c-ink-2);
  font-size: var(--t-cap);
}

.chip.on {
  background: var(--c-brand);
  border-color: var(--c-brand);
  color: var(--c-ink);
  font-weight: 600;
}

.area {
  flex: 1;
  height: 110rpx;
  box-sizing: border-box;
  font-size: var(--t-body);
  line-height: 1.5;
  color: var(--c-ink);
  background: transparent;
}

/* ---------- 底部 ---------- */
.foot {
  padding: 46rpx 30rpx 0;
}

.foot-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--t-cap);
  color: var(--c-ink-3);
}
