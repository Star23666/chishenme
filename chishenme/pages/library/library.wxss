.page {
  min-height: 100vh;
}

/* ---------- 卡片网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 14rpx 10rpx 0;
}

.dish-card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: var(--c-surface);
  border-radius: var(--r-card);
  overflow: hidden;
  position: relative;
}

.dish-img {
  width: 100%;
  height: 330rpx;
  display: block;
  background: var(--c-surface-sunk);
}

.dish-meta {
  padding: 16rpx 20rpx 22rpx;
}

.dish-name {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
}

.dish-main {
  font-size: var(--t-tag);
  color: var(--c-ink-3);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fav-dot {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 46rpx;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 112, 67, 0.94);
  color: #FFFFFF;
  font-size: var(--t-tag);
}

.tip {
  text-align: center;
  color: var(--c-ink-3);
  font-size: var(--t-cap);
  padding: 30rpx 0 10rpx;
}

/* ---------- 详情弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--c-surface);
  border-radius: var(--r-panel) var(--r-panel) 0 0;
  overflow: hidden;
}

.sheet-img {
  width: 100%;
  height: 560rpx;
  display: block;
  background: var(--c-surface-sunk);
}

.sheet-body {
  padding: 26rpx 30rpx 6rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.sheet-name {
  font-size: var(--t-h1);
  font-weight: 700;
  color: var(--c-ink);
}

.sheet-cat {
  margin-left: 16rpx;
  font-size: var(--t-tag);
  color: var(--c-brand);
  background: var(--c-brand-tint);
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
}

.sheet-row {
  display: flex;
  margin-bottom: 14rpx;
  font-size: var(--t-sub);
  line-height: 1.6;
}

.sheet-row .k {
  width: 90rpx;
  color: var(--c-ink-3);
  flex-shrink: 0;
}

.sheet-row .v {
  flex: 1;
  color: var(--c-ink-2);
}

.sheet-actions {
  display: flex;
  padding: 24rpx 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.act-fav {
  flex: 1;
  margin-right: 20rpx;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--r-pill);
  background: var(--c-surface-sunk);
  color: var(--c-ink-2);
  font-size: var(--t-body);
}

.act-add {
  flex: 2;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--r-pill);
  background: var(--c-brand);
  color: #FFFFFF;
  font-size: var(--t-body);
  font-weight: 600;
}
