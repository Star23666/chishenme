.page {
  min-height: 100vh;
}

/* ---------- 搜索框 ----------
   ★ 原来是一整块白色 topbar + 灰底胶囊输入框。
     现在：没有白底，输入区就是**纸上一根线**——像在纸上写了一行字。
   ★ 高度 76rpx 必须留着：微信 <input> 自带 height:1.4rem 默认样式，
     写了 box-sizing 就必须显式给 height，否则内容区算成负值、
     模拟器/浏览器复刻/静态检查**全都看不出来**，只有真机上整行字被裁掉。
     （wxml-check.js 的 F2 把这条锁住了） */
.topbar {
  background: transparent;
  padding: 24rpx 30rpx 0;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  /* 3rpx 而不是 2rpx：没有盒子之后，这根线就是「这里能打字」的唯一提示，
     太细了会读成一条普通的装饰线。 */
  border-bottom: 3rpx solid var(--c-line-strong);
}

.search-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 76rpx;
  font-size: var(--t-body);
  color: var(--c-ink);
}

/* 清空按钮：不做圆底（那是个小圆药丸），但**必须保住点击面积** ——
   纯 ✕ 字符在真机上只有十几像素宽，很难点中。 */
.search-clear {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: var(--t-sub);
  color: var(--c-ink-3);
}

/* ---------- 顶部：分类条 + 加菜 ----------
   分类条自己已经不带底了（见 app.wxss），这里只负责收口那根线。
   ★ scroll-view 必须 flex:1 + min-width:0 + overflow:hidden 才肯收缩 ——
     少了 min-width:0 它会按内容宽度撑开，把右边的按钮顶出屏幕。 */
.head {
  display: flex;
  align-items: center;
  background: transparent;
  border-bottom: 1rpx solid var(--c-line);
}

.head .cat-bar {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

/* 「＋ 加菜」：原来是主色纯文字。改成描边小按钮 ——
   它是补充动作，不能长得像主按钮（主按钮一屏只有一个）。 */
.add-dish {
  flex-shrink: 0;
  margin-right: 30rpx;
  padding: 12rpx 22rpx;
  font-size: var(--t-cap);
  font-weight: 600;
  color: var(--c-brand-ink);
  border: 1rpx solid var(--c-brand-line);
  border-radius: var(--r-btn);
}

/* ---------- 菜品网格 ----------
   ★ 这一页改动最明显：**删掉白卡**。
     原来每道菜是一个白底圆角盒子，80 道菜就是 80 个白盒子 ——
     这就是「卡片堆叠」本身。
     现在照片直接印在纸上，菜名写在照片下面。少一层盒子，
     不但更像菜谱上的一版小图，同一屏还能多看一道菜。

   ★★ 两列的宽度必须用**精确的减法**：`calc((100% - 缝) / 2)`。
     我第一版写的是「宽 calc(50% - 9rpx) + 奇数项 margin-right: 18rpx」——
     加起来正好 100%，flex 一取整就越界，结果**每一行只放得下一道菜**，
     整页变成单列。（截图里其实看得出来，我第一遍验收时看漏了。）
     现在用 justify-content: space-between 管缝，宽度不再参与凑数，
     最后一行只剩一道时也会自然靠左。 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx 30rpx 0;
}

.dish-card {
  width: calc((100% - 18rpx) / 2);
  margin: 0 0 26rpx 0;
  background: transparent;
  border-radius: 0;
  overflow: visible;
  position: relative;
}

.dish-img {
  width: 100%;
  height: 248rpx;
  display: block;
  border-radius: var(--r-thumb);
  background: var(--c-surface-sunk);
}

.dish-meta {
  padding: 14rpx 2rpx 0;
}

.dish-name {
  font-family: var(--f-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
}

.dish-main {
  font-size: var(--t-tag);
  color: var(--c-ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 收藏标记：★ 原来是「主色实心圆 + 白星」，一个很 App 的角标。
   改成一个**方角小纸印**，写一个「藏」字 —— 中式、安静，也不挡照片。
   位置从右上挪到左上：很多菜的照片右下角是盘子主体，右上反而更空。 */
.fav-dot {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 5rpx 9rpx;
  border-radius: 4rpx;
  background: rgba(246, 245, 243, 0.94);
  color: var(--c-brand-ink);
  font-size: var(--t-tag);
  line-height: 1;
}

/* 搜不到时的提示 */
.empty {
  text-align: center;
  color: var(--c-ink-3);
  font-size: var(--t-sub);
  line-height: 1.7;
  padding: 110rpx 60rpx 20rpx;
}

.tip {
  text-align: center;
  color: var(--c-ink-3);
  font-size: var(--t-cap);
  padding: 24rpx 0 10rpx;
}

/* ---------- 详情弹层 ----------
   弹层是「必须从纸上浮起来」的地方，所以它是全站少数还留着白色的地方。 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 30, 33, 0.55);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--c-surface);
  border-radius: var(--r-panel) var(--r-panel) 0 0;
  overflow: hidden;
}

.sheet-img {
  width: 100%;
  height: 520rpx;
  display: block;
  background: var(--c-surface-sunk);
}

.sheet-body {
  padding: 28rpx 30rpx 6rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

/* 把「编辑 / 删除」推到这一行的最右边 */
.head-gap {
  flex: 1;
}

/* 只有自己加的菜才会出现这两个。
   ★ 从药丸改成描边小方角，但**padding 一点没减** ——
     复刻量过：纯文字只有 23px 高，远低于好按的下限。
     降级的是「长相」，不是「手指够不够得着」。 */
.head-link {
  flex-shrink: 0;
  padding: 20rpx 26rpx;
  margin-left: 12rpx;
  border: 1rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
  background: transparent;
  color: var(--c-ink-2);
  font-size: var(--t-tag);
}

.head-link-danger {
  border-color: #F0C3BE;
  background: transparent;
  color: var(--c-danger);
}

.sheet-name {
  font-family: var(--f-serif);
  font-size: var(--t-h1);
  font-weight: 700;
  color: var(--c-ink);
  /* 菜名最长 12 字，加上分类标签和两个按钮会超出这一行。
     这里让菜名先让位（省略号），别把右边的按钮挤出屏幕。 */
  min-width: 0;
  flex-shrink: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 分类标签：淡橙胶囊 → 描边方角小标 */
.sheet-cat {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--t-tag);
  color: var(--c-brand-ink);
  border: 1rpx solid var(--c-brand-line);
  border-radius: var(--r-btn);
  padding: 4rpx 14rpx;
}

/* 主料 / 要点：★ 改成点线行 —— 菜名在左、值在右，中间那排点把两者连起来，
   像菜单上「红烧肉 …… 38」那种排法。 */
.sheet-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  font-size: var(--t-sub);
  line-height: 1.6;
}

.sheet-row .k {
  width: 90rpx;
  color: var(--c-ink-3);
  flex-shrink: 0;
}

.sheet-row .v {
  color: var(--c-ink-2);
}

.sheet-actions {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.act-fav {
  flex: 1;
  margin-right: 20rpx;
  text-align: center;
  padding: 22rpx 0;
  border: 1rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
  color: var(--c-ink-2);
  font-size: var(--t-body);
}

.act-add {
  flex: 2;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--r-btn);
  background: var(--c-brand);
  color: var(--c-ink);
  font-size: var(--t-body);
  font-weight: 600;
}

/* 详情里的「你改过这道菜」。
   刻意做得很轻：它是一句解释，不是一个状态标签。 */
.edited-note {
  margin: -8rpx 0 18rpx;
  font-size: var(--t-cap);
  color: var(--c-ink-3);
}

/* ---------- 房主专属：已被收起来的内置菜 ---------- */

/* 菜库底部的入口。发丝线框，不用实色块 ——
   它是补充信息，不能长得像「加入今日菜单」那种主要动作。 */
.hidden-bar {
  margin: 24rpx 30rpx 0;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
  text-align: center;
  font-size: var(--t-cap);
  color: var(--c-ink-2);
}

.restore-head {
  padding: 32rpx 30rpx 6rpx;
}

.restore-title {
  font-family: var(--f-serif);
  font-size: var(--t-h1);
  font-weight: 700;
  color: var(--c-ink);
}

.restore-sub {
  margin-top: 12rpx;
  font-size: var(--t-cap);
  color: var(--c-ink-3);
  line-height: 1.6;
}

/* scroll-view 必须有个高度上限，否则里面菜一多会把整屏顶满 */
.restore-list {
  max-height: 620rpx;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
}

.restore-row {
  display: flex;
  align-items: center;
  padding: 18rpx 10rpx;
  border-bottom: 1rpx solid var(--c-line);
}

/* 最后一行不画线，免得和下面的按钮贴在一起显脏 */
.restore-row:last-child {
  border-bottom: none;
}

.restore-img {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--r-thumb);
  background: var(--c-surface-sunk);
}

.restore-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.restore-name {
  font-family: var(--f-serif);
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--c-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.restore-cat {
  margin-top: 4rpx;
  font-size: var(--t-tag);
  color: var(--c-ink-3);
}

.restore-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 16rpx 28rpx;
  border: 1rpx solid var(--c-brand-line);
  border-radius: var(--r-btn);
  color: var(--c-brand-ink);
  font-size: var(--t-tag);
  font-weight: 600;
}

.restore-foot {
  display: flex;
  align-items: center;
  padding: 22rpx 30rpx;
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
}

.restore-all {
  flex: 1;
  margin-right: 20rpx;
  text-align: center;
  padding: 22rpx 0;
  border: 1rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
  color: var(--c-ink-2);
  font-size: var(--t-body);
}

.restore-close {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--r-btn);
  background: var(--c-brand);
  color: var(--c-ink);
  font-size: var(--t-body);
  font-weight: 600;
}
