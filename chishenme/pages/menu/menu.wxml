<!-- 今日菜单：清单 + 统计 + 转发 -->
<view class="page">

  <!-- 抬头：日期 + 一句标题 + 一句人话。
       ★ 原来这里是「主色大块 + 5 个数字排成一行」（共几道/荤/素/汤/主食/凉菜）——
         那是「大数字＋支撑统计」，最容易一眼看出是模板的写法。
         换成两句话之后信息一点没少，读起来却是「一桌菜」而不是「一张报表」。
         配比和总数都由数据层算好（app.menuMixText / menuTotalText），
         页面只负责显示。 -->
  <view class="hero">
    <view class="hero-date">{{dateText}}</view>
    <view class="hero-title">{{nextDay ? '明天吃这些' : '今天吃这些'}}</view>
    <view class="hero-say">{{mixText}}</view>
    <view class="hero-say hero-total">{{totalText}}</view>
    <view class="hero-rule"></view>
  </view>

  <!-- 家庭状态条：只有配了云开发才出现，本地模式下这一页和以前一模一样 -->
  <view class="fbar" wx:if="{{cloud}}" bindtap="goFamily">
    <view class="fbar-l">
      <text class="fbar-dot"></text>
      <text wx:if="{{fam}}">{{fam.name}} {{fam.memberCount}} 人共享</text>
      <text wx:else>还没和家人连上，点这里设置</text>
    </view>
    <view class="fbar-r">{{fam ? fam.code : '去建房间'}} ›</view>
  </view>

  <!-- 过了 22:30：今天那份菜单已经清空，这一页装的是「明天」那份。
       不加这条的话，隔天早上看到昨晚点的菜还在（或者晚上看到菜单突然空了）
       都会以为是丢了数据 —— 这正是必须解释一句的地方。 -->
  <view class="nextbar" wx:if="{{nextDay}}">
    <text class="nextbar-t">已经过了 <text class="nextbar-time">{{cutoff}}</text>，今天那份菜单已清空</text>
    <text class="nextbar-d">现在点的是「明天」的菜，明早打开还在</text>
  </view>

  <view class="empty" wx:if="{{empty}}">
    <view class="empty-title">{{nextDay ? '明天的菜单还是空的' : '今天还没点菜'}}</view>
    <view class="empty-desc">去「点菜」挑几道，<br />或者去「摇一摇」让天意决定</view>
    <view class="empty-btns">
      <view class="eb" bindtap="goLibrary">去点菜</view>
      <view class="eb eb-dark" bindtap="goRandom">摇一摇</view>
    </view>
  </view>

  <block wx:else>
    <view class="mlist">
      <view class="mitem" wx:for="{{list}}" wx:key="dishId">
        <image class="mitem-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="mitem-mid">
          <!-- 菜名 …… 份数：中间那排点把两头连起来，是菜单上「红烧肉 …… 两份」的排法。
               份数写成中文（数据层拼好），阿拉伯数字读起来像表格。 -->
          <view class="mitem-line">
            <text class="mitem-name">{{item.name}}</text>
            <view class="dots"></view>
            <text class="mitem-qty">{{item.qtyText}}</text>
          </view>
          <!-- 「谁点的」比「它是荤菜」更值得占这一行；没人认领时才退回显示分类 -->
          <view class="mitem-by" wx:if="{{item.hasBy}}">{{item.byText}} 点的</view>
          <view class="mitem-cat" wx:else>{{item.catName}}</view>
          <view class="mitem-note" wx:if="{{item.note}}">备注：{{item.note}}</view>
        </view>
        <!-- 动作放在**行尾右侧、竖着排**：它是要点的东西，
             压在文字下面既难点、也不像个动作。
             按钮尺寸按手指给足（见 .mo-btn），别为了紧凑缩回去。 -->
        <view class="mitem-ops">
          <view class="mo-btn" wx:if="{{item.qty > 1}}" data-id="{{item.dishId}}" bindtap="minus">减一份</view>
          <view class="mo-btn mo-del" data-id="{{item.dishId}}" bindtap="remove">移除</view>
        </view>
      </view>
    </view>

    <!-- 转发是这一页真正的主要动作，所以它一个人占那个「实心块」的名额；
         复制和清空降级成文字链。 -->
    <button class="op-share" open-type="share">转发给家人</button>

    <view class="ops">
      <view class="op-btn" bindtap="copyText">复制菜单文字</view>
      <view class="op-btn op-danger" bindtap="clearAll">清空菜单</view>
    </view>

    <view class="foot-tip" wx:if="{{fam}}">10.30清空菜单，请老婆大人注意时间</view>
    <view class="foot-tip" wx:else>转发出去了，家里人点开就能看到这个菜库</view>
  </block>

  <view class="safe-bottom"></view>
</view>
