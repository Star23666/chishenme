.page {
  min-height: 100vh;
}

/* ---------- 抬头 ----------
   ★ 这一块原来最「模板」：一整块主色 + 5 个数字（共几道/荤/素/汤/主食/凉菜）
     排成一行 —— 就是设计里最常见的「大数字＋支撑统计」配方。
     现在换成：日期 + 一句标题 + 两句人话 + 一根主色收口线。
     信息一点没少，但它读起来是「一桌菜」，不是「一张报表」。
     而且主色不再用来刷整块底，只留这一根线（主色的用法收窄到四处之一）。 */
.hero {
  padding: 30rpx 30rpx 0;
}

.hero-date {
  font-size: var(--t-cap);
  color: var(--c-ink-2);
}

.hero-title {
  font-family: var(--f-serif);
  font-size: var(--t-display);
  font-weight: 700;
  line-height: 1.15;
  color: var(--c-ink);
  margin: 8rpx 0 12rpx;
}

.hero-say {
  font-size: var(--t-sub);
  color: var(--c-ink-2);
  line-height: 1.55;
}

.hero-total {
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--c-ink);
  margin-top: 2rpx;
}

.hero-rule {
  height: 6rpx;
  background: var(--c-brand);
  margin-top: 24rpx;
}

/* ---------- 家庭状态条 ----------
   ★ 原来是「主色淡底 + 6rpx 主色左竖线」的通栏 —— 这种「淡底 + 左竖线」
     是中后台里最常见的状态条形状。
     现在它只是纸上一行：一个绿点 + 一句小字 + 右边的房间码（宋体）。 */
.fbar {
  display: flex;
  align-items: center;
  padding: 22rpx 30rpx;
  background: transparent;
  border-bottom: 1rpx solid var(--c-line);
}

.fbar-l {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fbar-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-ok);
  margin-right: 12rpx;
}

.fbar-r {
  flex-shrink: 0;
  font-family: var(--f-serif);
  font-size: var(--t-sub);
  color: var(--c-ink);
  margin-left: 16rpx;
}

/* ---------- 「已经翻篇了」提示条 ----------
   只在过了 22:30 出现。故意不用品牌淡底：它上面紧挨着的家庭状态条已经是
   浅色行了，两条同色叠在一起就分不出哪个是「状态」哪个是「提示」。 */
.nextbar {
  margin: 16rpx 30rpx 0;
  padding: 20rpx 26rpx;
  background: var(--c-surface-sunk);
  border-left: 6rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
}

.nextbar-t {
  display: block;
  font-size: var(--t-sub);
  color: var(--c-ink-2);
}

.nextbar-time {
  color: var(--c-brand-ink);
  font-weight: 600;
}

.nextbar-d {
  display: block;
  font-size: var(--t-cap);
  color: var(--c-ink-3);
  margin-top: 6rpx;
}

/* ---------- 菜单清单 ----------
   ★ 去掉白底容器（原来 .mlist 是一整块白卡）。
     现在一行一道菜，行间一根暖发丝线，菜名和份数之间用点线连起来 ——
     这是菜单（水牌）的排法，不是列表卡片的排法。 */
.mlist {
  background: transparent;
  margin: 0;
  padding: 0 30rpx;
  border-radius: 0;
  overflow: visible;
}

.mitem {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.mitem:last-child {
  border-bottom: none;
}

.mitem-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--r-thumb);
  background: var(--c-surface-sunk);
  flex-shrink: 0;
}

.mitem-mid {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

/* 菜名 …… 份数 的同一行 */
.mitem-line {
  display: flex;
  align-items: baseline;
}

.mitem-name {
  font-family: var(--f-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
}

/* ★ 份数原来是主色小字，对纸底只有 2.45:1，不达标。改成墨色：
   它本来就不该抢眼，菜名才是主。 */
.mitem-qty {
  flex-shrink: 0;
  font-family: var(--f-serif);
  font-size: var(--t-cap);
  color: var(--c-ink);
}

.mitem-cat {
  font-size: var(--t-tag);
  color: var(--c-ink-3);
  margin-top: 6rpx;
}

/* ★ 「谁点的」分两级：
   别人点的用中性色（它是次要信息）；**自己点的**用灶红 + 加粗，
   一眼能扫到 —— 家人想改自己那行，不用先找一遍。 */
.mitem-by {
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mitem-by-me {
  color: var(--c-brand-ink);
  font-weight: 600;
}

.mitem-note {
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 行内动作：★ 放在行尾右侧、竖着排。
   第一版把它降级成文字链塞在菜名下面，问题是它「不像个动作」——
   要点的东西得看得见、够得着，所以这里给回按钮的形状和尺寸。 */
.mitem-ops {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  margin-left: 16rpx;
}

/* ★ 尺寸按手指给：高 68rpx（34px）、宽至少 136rpx（68px）。
   两个按钮都出现时，这一列会比 108rpx 的缩略图还高一点，
   行高跟着长一点是值得的 —— 难点中比整齐重要。 */
.mo-btn {
  min-width: 136rpx;
  text-align: center;
  padding: 17rpx 0;
  border: 1rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
  font-size: var(--t-sub);
  color: var(--c-ink-2);
  background: transparent;
}

.mo-btn + .mo-btn {
  margin-top: 14rpx;
}

/* 移除：破坏性动作，用淡边 + 红字，不用实心（实心块一屏只留一个） */
.mo-del {
  color: var(--c-danger);
  border-color: #F0C3BE;
}

/* ---------- 操作区 ---------- */

/* 这一页真正的主要动作（转发），一个人占掉「实心块」的名额 */
.op-share {
  margin: 30rpx 30rpx 0;
  padding: 26rpx 0;
  background: var(--c-brand);
  color: var(--c-ink);
  border-radius: var(--r-btn);
  font-size: var(--t-body);
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

/* 去掉 <button> 自带的那圈边框和背景 */
.op-share::after {
  border: none;
}

/* 其余两个动作降级成一行文字链，中间一根发丝竖线 */
.ops {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx 6rpx;
}

.op-btn {
  flex: 1;
  text-align: center;
  padding: 6rpx 0;
  background: transparent;
  border-radius: 0;
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  margin-bottom: 0;
}

.op-btn + .op-btn {
  border-left: 1rpx solid var(--c-line-strong);
}

.op-danger {
  color: var(--c-danger);
}

.foot-tip {
  text-align: center;
  font-size: var(--t-cap);
  color: var(--c-ink-3);
  padding: 10rpx 40rpx 0;
  line-height: 1.7;
}
