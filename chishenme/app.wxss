/* ===== 全局样式 ===== */

/*
 * 【设计令牌】
 * ---------------------------------------------------------------------------
 * 这一层是整个观感的地基。上一轮做的事是「收敛」：
 *   6 种野生灰 → 4 档；15 种字号 → 7 档；圆角从「一律 20rpx」开始分层级。
 *
 * 这一轮（v1.7.0）做的事是「去掉后台感」。量化过，症结就两条：
 *   ① 白底容器 18 处（`background: var(--c-surface)`）—— 头部、列表、表单、
 *      弹层全是白盒子，这才是「卡片堆叠」的实体；
 *   ② 胶囊圆角 25 处 —— 按钮、标签、头像一律药丸，全站同一个圆角 = 没有层级。
 * 加上菜单页把 5 个数字排成一行（「大数字＋支撑统计」的默认写法），
 * 合起来就是「一眼像 SaaS 后台」。
 *
 * 所以这一轮定下四条不变量，7 个页面都守：
 *   1. **白不再做容器底**。列表 / 分组 / 头部直接落在纸上；白只留给弹层和输入框。
 *   2. **一屏最多一个实心块动作**，其余动作降级成 .tx（带细下划线的文字链）。
 *   3. **主色只出现在四处**：选中的横线、点线、主按钮底、印章边。不再拿它刷填充块。
 *   4. **结构靠暖色发丝线和留白**，不靠盒子、不靠阴影（全站至今 box-shadow 为 0，
 *      这条要继续守住 —— 阴影是最容易被手滑加回来的模板味）。
 *
 * ★ 注意：--c-brand 必须和 app.json 的 tabBar.selectedColor、
 *   以及 .workbuddy/tools/gen-tab-icons.py 里的颜色常量保持一致，
 *   改它要同步三处并重跑图标脚本。（这一轮没动它。）
 */
page {
  /* ---- 颜色：主色 ---- */
  --c-brand:        #FF7043;   /* 番茄橙，全站唯一的重音。只做「面」 */
  --c-brand-deep:   #E85A2C;   /* 按下 / 加深 */
  --c-brand-tint:   #FFF1EC;   /* 主色淡底：用得很少，只给「我 / 房主」这类小标 */
  --c-brand-line:   #FFDCCF;   /* 主色淡边 */

  /* ★ 新增：主色派生出来的「能当字用」的深色。
     #FF7043 对纸底 --c-bg 只有 2.45:1，当正文远不达标；
     这个是 5.3:1。分工：橙管「面」，它管「字」。
     凡是「想用主色的文字」，一律用它，别直接用 --c-brand。 */
  --c-brand-ink:    #B23A18;

  /* ---- 颜色：底与面 ----
     底色是色度极低的暖白：菜品照片挂在冷灰上会发青、显得不新鲜。
     ★ --c-surface 现在**不再当容器底**了（原来 18 处），
       只在「必须从纸上浮起来」的地方用：底部弹层、输入框。 */
  --c-bg:           #F6F5F3;
  --c-surface:      #FFFFFF;
  --c-surface-sunk: #EFEBE5;   /* ★ 暖化（原 #F1F0EE）：下沉面 */

  /* ---- 颜色：文字（4 档）----
     ★ 1.5.8 按 WCAG 实测重排过一次，下面是**算过对比度**的（对纸底 #F6F5F3）：

       ink   #1C1E21  15.33:1  ✅ 正文/标题
       ink-2 #5F5952   6.35:1  ✅ 次要
       ink-3 #6B655D   5.29:1  ✅ 弱文字（原来 #8A8F99 只有 2.98:1，差 34%）
       ink-4 #7D766C   4.12:1  ⚠️ 见下方说明

     ★ 两个变化，别改回去：
       1. **更深**：ink-3 原来 2.98:1、ink-4 原来 1.87:1，都够不到 AA 的 4.5。
          而这两档被用了 48 处（分类、主料、几份、说明、占位符）——
          这不是"配色口味"，是小字看不清。
       2. **更暖**：原来的灰都是冷灰（#8A8F99 的蓝分量最高），
          而底是暖白。之前把「线」暖化过，字没跟上，所以小字看着略"脏"。

     ★★ ink-4 有意停在 4.12:1，**没到 4.5**：它只做占位符和"禁用"，
        必须比真值（ink 的 15.33）弱。压到 4.5 会和已填内容混淆。
        这是有意识的取舍，不是没算。要严格 AA 就把占位符改用 ink-3。
     ★ 改 ink-3 要同步三处：这里、app.json 的 tabBar.color、
       .workbuddy/tools/gen-tab-icons.py 的 NORMAL（并重跑图标脚本），
       否则 tabBar 文字和图标会不是同一个灰。 */
  --c-ink:          #1C1E21;   /* 15.33:1 */
  --c-ink-2:        #5F5952;   /*  6.35:1 ★原 #585F6B（冷灰） */
  --c-ink-3:        #6B655D;   /*  5.29:1 ★原 #8A8F99（2.98:1，差 34%） */
  --c-ink-4:        #7D766C;   /*  4.12:1 ★原 #B0B6C0（1.87:1，差 58%） */

  /* ---- 颜色：线与状态 ----
     ★ 全部暖化。原来的 #E9EAEC / #DCDEE1 是冷灰，
       挂在暖白纸上会发青 —— 整页就不像「一张纸」，像一块屏。 */
  --c-line:         #E6E1DA;   /* ★ 原 #E9EAEC */
  --c-line-strong:  #D8D1C7;   /* ★ 原 #DCDEE1 */
  --c-ok:           #2E9E5B;   /* 在线 / 已同步 */
  --c-danger:       #C0392B;   /*  4.99:1 ★原 #D9483B（3.90:1，不够） */
  --c-danger-tint:  #FDF0EE;   /* 危险操作的淡底：目前只有「解散房间」用 */

  /* ---- 圆角：4 档 → 3 档，每一档只干一件事 ----
     ★ --r-pill 从「哪都用」缩到「只给二选一的模式开关」——
       胶囊本来是「切换」的形状，用在按钮和标签上就变模板了。 */
  --r-panel: 28rpx;   /* 底部弹层顶部，仅此 */
  --r-thumb: 10rpx;   /* 照片缩略图，仅此 */
  --r-btn:    6rpx;   /* 按钮 / 标签 / 输入框：接近直角 */
  --r-pill: 999rpx;   /* ★ 只给「随机一道 / 三菜一汤」那种二选一 */

  /* ---- 字号（8 档，1.5.10 重排）----
     ★ 上一版的问题：`--t-sub`(28) 和 `--t-body`(29) 只差 1rpx，
       肉眼完全是同一个大小 —— 名义 9 档，实际只能辨出 6 档。
       （这是 1.5.6 为了「长辈看得清」抬下限时挤出来的，两件事一起收。）

     现在 8 档，相邻比值写在右边（24→64）：
       tag      24rpx (12.0px)
       cap      28rpx (14.0px)  ÷24 = 1.17  ← 吸收掉原来的 sub(28)
       body     32rpx (16.0px)  ÷28 = 1.14  ← 14.5px → 16px（正文字号的标准值）
       h2       36rpx (18.0px)  ÷32 = 1.13
       h1       40rpx (20.0px)  ÷36 = 1.11
       display  48rpx (24.0px)  ÷40 = 1.20
       big      56rpx (28.0px)  ÷48 = 1.17
       hero     64rpx (32.0px)  ÷56 = 1.14

     ★ 评审里我写的是「7 档、每档 ≥1.14」，实际做到 **8 档、两处 1.11–1.13**。
       为什么没做到：要 7 档覆盖 12→32px，比值必须 1.18，那样 h1/display 要涨
       20% 以上 —— 会把按钮文字和菜名一起撑大，风险远大于收益。
       所以我保住了**小字端完全达标**（12/14/16 三个最常用的档，比值 1.17/1.14），
       顶部两处接受 1.11–1.13。这是有取舍的，不是没算。

     ★ 只给「摇一摇」滚动结果留了 hero 这一处大胆。 */
  --t-hero:    64rpx;
  --t-big:     56rpx;  /* 只给「要念给别人听」的短码：房间码 */
  --t-display: 48rpx;  /* 一页只允许出现一次 */
  --t-h1:      40rpx;
  --t-h2:      36rpx;
  --t-body:    32rpx;
  --t-cap:     28rpx;
  --t-tag:     24rpx;

  /* ★ 新增：菜名 / 大标题 / 房间码用的系统衬线栈。
     小程序做不到自定义字体，这是唯一能借到的「印在纸上」的味道：
     iOS 上是真宋体（笔画有粗细对比），Android 多数机型没有中文衬线、
     会回退成系统黑体 —— **版面不塌**，只是少点味道。
     所以它当加分项用，不当承重结构：任何靠它撑起来的层级都不合格。 */
  --f-serif: "Songti SC", "STSong", "SimSun", serif;

  /* ---- 间距（1.5.9 归网格）----
     ★ 基准 8rpx = 4pt。间距只用这几档：
       4 / 8 / 12 / 16 / 24 / 32 / 40 / 48 / 64
     别再写 22 / 26 / 34 这种 —— 归网格前有 **28 个不同取值**，
     22/24/26/28 四个几乎分不出，整体看着"哪里都差一点点"。
     ★ `--gutter` 是**唯一例外**：页面左右槽宽 30rpx。
       它决定全站内容宽度（750 − 60 = 690），硬归到 32 会让每页窄 4rpx、
       所有页都要重看，所以单独提成语义令牌 ——
       它不是"随手写的一个数"，而是「页边距」这件事本身。 */

  --gutter: 30rpx;

  background: var(--c-bg);
  color: var(--c-ink);
  font-size: var(--t-body);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* ---- 分类横向筛选条 ----
   ★ 原来是「灰底胶囊 chip」。胶囊是「切换」的形状，一排在顶上就成了
     每个 App 都有的筛选条 —— 后台感的一大来源。
     改成**文字 + 选中项底下一道主色横线**：横线只跟文字一样长，
     像菜单上被人用笔圈了一道。 */
.cat-bar {
  white-space: nowrap;
  background: transparent;
  padding: 24rpx 0 0;
}

.cat-item {
  display: inline-block;
  padding: 0 0 12rpx;
  margin-left: 32rpx;
  font-size: var(--t-body);
  color: var(--c-ink-2);
  background: transparent;
  border-bottom: 6rpx solid transparent;
}

.cat-item:last-child {
  margin-right: 32rpx;
}

.cat-item.on {
  color: var(--c-ink);
  font-weight: 600;
  border-bottom-color: var(--c-brand);
}

/* ---- 通用容器 ----
   ★ 这个类以前是「白底 + 圆角卡片」，是 18 处白盒子的来源。
     现在它退化成「一段内容」，不再有底、不再有圆角 ——
     分段靠的是发丝线（各页自己画）和留白。
     保留类名是为了不动 WXML：v1.7.0 改的是样式，尽量不碰结构。 */
.card {
  background: transparent;
  border-radius: 0;
  overflow: visible;
}

/* ---- 分区标题 ----
   ★ 原来是一句灰色小字，读起来像「后台的分组标签」。
     改成**主色短横 + 宋体组名**：短横是结构（在说「这里起一段」），不是装饰。
     注意：它只适合「分组名」（荤菜 / 家里人）。整句话别用它。 */
.section-title {
  display: flex;
  align-items: center;
  padding: 32rpx var(--gutter) 12rpx;
  font-family: var(--f-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
}

.section-title::before {
  content: "";
  flex-shrink: 0;
  width: 26rpx;
  height: 6rpx;
  margin-right: 16rpx;
  background: var(--c-brand);
}

/* ---- 文字动作 ----
   ★ 原来这些位置全是胶囊按钮（25 处里的大部分），一屏能堆六七个，
     正是「按钮汤」。改成「带细下划线的文字」：
     仍然一眼看得出能点（下划线 + 间距），但不再抢实心按钮的位置。 */
.tx {
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  border-bottom: 1rpx solid var(--c-line-strong);
  padding-bottom: 4rpx;
}

.tx-brand {
  color: var(--c-brand-ink);
  border-bottom-color: var(--c-brand);
}

.tx-danger {
  color: var(--c-danger);
  border-bottom-color: #F0C3BE;
}

/* ---- 描边小按钮 ----
   补充动作专用（「＋ 加菜」这种）。直角描边，不加底。 */
.ghost {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  border: 1rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
}

/* ---- 点线 ----
   菜名和份数之间那排点。菜单页 / 弹层的信息行共用。
   ★ 用主色的点而不是虚线 border：点更细、更像印刷出来的引线。 */
.dots {
  flex: 1;
  min-width: 24rpx;
  height: 2rpx;
  margin-bottom: 8rpx;
  background-image: radial-gradient(circle, var(--c-brand) 1.8rpx, transparent 2rpx);
  background-size: 10rpx 4rpx;
  background-repeat: repeat-x;
  opacity: 0.62;
}

/* ---- 空状态 ----
   空屏不是「暂无数据」，是给下一步。 */
.empty {
  padding: 168rpx 64rpx;
  text-align: center;
}

.empty-title {
  font-family: var(--f-serif);
  font-size: var(--t-h1);
  font-weight: 600;
  color: var(--c-ink);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: var(--t-cap);
  color: var(--c-ink-3);
  line-height: 1.7;
}

/* 空状态里的按钮（菜单页、收藏页共用，所以放全局） */
.empty-btns {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
}

/* ★ 一个描边、一个实心：一屏只有一个实心块动作。 */
.eb {
  padding: 24rpx 40rpx;
  border-radius: var(--r-btn);
  border: 1rpx solid var(--c-line-strong);
  color: var(--c-ink-2);
  font-size: var(--t-body);
  margin: 0 12rpx;
}

.eb-dark {
  border-color: var(--c-brand);
  background: var(--c-brand);
  /* ★ 墨字压橙底 = 5.98:1；白字只有 2.74:1，不达标 */
  color: var(--c-ink);
  font-weight: 600;
}

/* ---- 主按钮 ----
   ★ 两处改动：胶囊 → 直角（--r-btn）；白字 → 墨字（对比度 2.74:1 → 5.98:1）。
     一屏最多出现一个。 */
.btn-primary {
  background: var(--c-brand);
  color: var(--c-ink);
  border-radius: var(--r-btn);
  font-size: var(--t-h2);
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
}

.btn-primary.disabled {
  background: var(--c-line-strong);
  color: var(--c-ink-3);
}

/* ---- 输入框占位文字 ----
   微信默认的 placeholder 是很浅的灰且各平台不一致，统一压到最淡那一档。
   用 placeholder-class="ph" 引用（加菜页的两个 input 和一个 textarea）。 */
.ph {
  color: var(--c-ink-4);
}

/* ---- 底部安全区占位 ---- */
.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
