/* ===== 全局样式 ===== */

/*
 * 【设计令牌】
 * ---------------------------------------------------------------------------
 * 这一层是整个观感的地基。上一轮做的事是「收敛」：
 *   6 种野生灰 → 4 档；15 种字号 → 7 档；圆角从「一律 20rpx」开始分层级。
 *
 * 这一轮（v1.7.0）做的事是「去掉后台感」。量化过，症结就两条：
 *   ① 白底容器 18 处（`background: var(--c-surface)`）—— 头部、列表、表单、
 *      弹层全是白盒子，这才是「卡片堆叠」的实体；
 *   ② 胶囊圆角 25 处 —— 按钮、标签、头像一律药丸，全站同一个圆角 = 没有层级。
 * 加上菜单页把 5 个数字排成一行（「大数字＋支撑统计」的默认写法），
 * 合起来就是「一眼像 SaaS 后台」。
 *
 * 所以这一轮定下四条不变量，7 个页面都守：
 *   1. **白不再做容器底**。列表 / 分组 / 头部直接落在纸上；白只留给弹层和输入框。
 *   2. **一屏最多一个实心块动作**，其余动作降级成 .tx（带细下划线的文字链）。
 *   3. **主色只出现在四处**：选中的横线、点线、主按钮底、印章边。不再拿它刷填充块。
 *   4. **结构靠暖色发丝线和留白**，不靠盒子、不靠阴影（全站至今 box-shadow 为 0，
 *      这条要继续守住 —— 阴影是最容易被手滑加回来的模板味）。
 *
 * ★ 注意：--c-brand 必须和 app.json 的 tabBar.selectedColor、
 *   以及 .workbuddy/tools/gen-tab-icons.py 里的颜色常量保持一致，
 *   改它要同步三处并重跑图标脚本。（这一轮没动它。）
 */
page {
  /* ---- 颜色：主色 ---- */
  --c-brand:        #FF7043;   /* 番茄橙，全站唯一的重音。只做「面」 */
  --c-brand-deep:   #E85A2C;   /* 按下 / 加深 */
  --c-brand-tint:   #FFF1EC;   /* 主色淡底：用得很少，只给「我 / 房主」这类小标 */
  --c-brand-line:   #FFDCCF;   /* 主色淡边 */

  /* ★ 新增：主色派生出来的「能当字用」的深色。
     #FF7043 对纸底 --c-bg 只有 2.45:1，当正文远不达标；
     这个是 5.3:1。分工：橙管「面」，它管「字」。
     凡是「想用主色的文字」，一律用它，别直接用 --c-brand。 */
  --c-brand-ink:    #B23A18;

  /* ---- 颜色：底与面 ----
     底色是色度极低的暖白：菜品照片挂在冷灰上会发青、显得不新鲜。
     ★ --c-surface 现在**不再当容器底**了（原来 18 处），
       只在「必须从纸上浮起来」的地方用：底部弹层、输入框。 */
  --c-bg:           #F6F5F3;
  --c-surface:      #FFFFFF;
  --c-surface-sunk: #EFEBE5;   /* ★ 暖化（原 #F1F0EE）：下沉面 */

  /* ---- 颜色：文字（4 档）---- */
  --c-ink:          #1C1E21;   /* 主文字 */
  --c-ink-2:        #585F6B;   /* 次要 */
  --c-ink-3:        #8A8F99;   /* 弱（和 tabBar 图标灰保持一致，别改） */
  --c-ink-4:        #B0B6C0;   /* 最淡：占位、脚注 */

  /* ---- 颜色：线与状态 ----
     ★ 全部暖化。原来的 #E9EAEC / #DCDEE1 是冷灰，
       挂在暖白纸上会发青 —— 整页就不像「一张纸」，像一块屏。 */
  --c-line:         #E6E1DA;   /* ★ 原 #E9EAEC */
  --c-line-strong:  #D8D1C7;   /* ★ 原 #DCDEE1 */
  --c-ok:           #2E9E5B;   /* 在线 / 已同步 */
  --c-danger:       #D9483B;
  --c-danger-tint:  #FDF0EE;   /* 危险操作的淡底：目前只有「解散房间」用 */

  /* ---- 圆角：4 档 → 3 档，每一档只干一件事 ----
     ★ --r-pill 从「哪都用」缩到「只给二选一的模式开关」——
       胶囊本来是「切换」的形状，用在按钮和标签上就变模板了。 */
  --r-panel: 28rpx;   /* 底部弹层顶部，仅此 */
  --r-thumb: 10rpx;   /* 照片缩略图，仅此 */
  --r-btn:    6rpx;   /* 按钮 / 标签 / 输入框：接近直角 */
  --r-pill: 999rpx;   /* ★ 只给「随机一道 / 三菜一汤」那种二选一 */

  /* ---- 字号（7 档，沿用）----
     --t-hero 是唯一的例外：只给「摇一摇」滚动结果那一行用。
     全站把「大胆」花在这一处，其他所有地方都安静。 */
  --t-hero:    64rpx;
  --t-display: 44rpx;  /* 一页只允许出现一次 */
  --t-big:     56rpx;  /* 只给「要念给别人听」的短码：房间码 */
  --t-h1:      36rpx;
  --t-h2:      32rpx;
  --t-body:    29rpx;
  --t-sub:     26rpx;
  --t-cap:     23rpx;
  --t-tag:     21rpx;

  /* ★ 新增：菜名 / 大标题 / 房间码用的系统衬线栈。
     小程序做不到自定义字体，这是唯一能借到的「印在纸上」的味道：
     iOS 上是真宋体（笔画有粗细对比），Android 多数机型没有中文衬线、
     会回退成系统黑体 —— **版面不塌**，只是少点味道。
     所以它当加分项用，不当承重结构：任何靠它撑起来的层级都不合格。 */
  --f-serif: "Songti SC", "STSong", "SimSun", serif;

  background: var(--c-bg);
  color: var(--c-ink);
  font-size: var(--t-body);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* ---- 分类横向筛选条 ----
   ★ 原来是「灰底胶囊 chip」。胶囊是「切换」的形状，一排在顶上就成了
     每个 App 都有的筛选条 —— 后台感的一大来源。
     改成**文字 + 选中项底下一道主色横线**：横线只跟文字一样长，
     像菜单上被人用笔圈了一道。 */
.cat-bar {
  white-space: nowrap;
  background: transparent;
  padding: 20rpx 0 0;
}

.cat-item {
  display: inline-block;
  padding: 0 0 12rpx;
  margin-left: 34rpx;
  font-size: var(--t-body);
  color: var(--c-ink-2);
  background: transparent;
  border-bottom: 6rpx solid transparent;
}

.cat-item:last-child {
  margin-right: 34rpx;
}

.cat-item.on {
  color: var(--c-ink);
  font-weight: 600;
  border-bottom-color: var(--c-brand);
}

/* ---- 通用容器 ----
   ★ 这个类以前是「白底 + 圆角卡片」，是 18 处白盒子的来源。
     现在它退化成「一段内容」，不再有底、不再有圆角 ——
     分段靠的是发丝线（各页自己画）和留白。
     保留类名是为了不动 WXML：v1.7.0 改的是样式，尽量不碰结构。 */
.card {
  background: transparent;
  border-radius: 0;
  overflow: visible;
}

/* ---- 分区标题 ----
   ★ 原来是一句灰色小字，读起来像「后台的分组标签」。
     改成**主色短横 + 宋体组名**：短横是结构（在说「这里起一段」），不是装饰。
     注意：它只适合「分组名」（荤菜 / 家里人）。整句话别用它。 */
.section-title {
  display: flex;
  align-items: center;
  padding: 34rpx 30rpx 12rpx;
  font-family: var(--f-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--c-ink);
}

.section-title::before {
  content: "";
  flex-shrink: 0;
  width: 26rpx;
  height: 6rpx;
  margin-right: 14rpx;
  background: var(--c-brand);
}

/* ---- 文字动作 ----
   ★ 原来这些位置全是胶囊按钮（25 处里的大部分），一屏能堆六七个，
     正是「按钮汤」。改成「带细下划线的文字」：
     仍然一眼看得出能点（下划线 + 间距），但不再抢实心按钮的位置。 */
.tx {
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  border-bottom: 1rpx solid var(--c-line-strong);
  padding-bottom: 3rpx;
}

.tx-brand {
  color: var(--c-brand-ink);
  border-bottom-color: var(--c-brand);
}

.tx-danger {
  color: var(--c-danger);
  border-bottom-color: #F0C3BE;
}

/* ---- 描边小按钮 ----
   补充动作专用（「＋ 加菜」这种）。直角描边，不加底。 */
.ghost {
  display: inline-block;
  padding: 12rpx 22rpx;
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  border: 1rpx solid var(--c-line-strong);
  border-radius: var(--r-btn);
}

/* ---- 点线 ----
   菜名和份数之间那排点。菜单页 / 弹层的信息行共用。
   ★ 用主色的点而不是虚线 border：点更细、更像印刷出来的引线。 */
.dots {
  flex: 1;
  min-width: 24rpx;
  height: 2rpx;
  margin-bottom: 10rpx;
  background-image: radial-gradient(circle, var(--c-brand) 1.8rpx, transparent 2rpx);
  background-size: 10rpx 4rpx;
  background-repeat: repeat-x;
  opacity: 0.62;
}

/* ---- 空状态 ----
   空屏不是「暂无数据」，是给下一步。 */
.empty {
  padding: 170rpx 60rpx;
  text-align: center;
}

.empty-title {
  font-family: var(--f-serif);
  font-size: var(--t-h1);
  font-weight: 600;
  color: var(--c-ink);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: var(--t-sub);
  color: var(--c-ink-3);
  line-height: 1.7;
}

/* 空状态里的按钮（菜单页、收藏页共用，所以放全局） */
.empty-btns {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 44rpx;
}

/* ★ 一个描边、一个实心：一屏只有一个实心块动作。 */
.eb {
  padding: 20rpx 44rpx;
  border-radius: var(--r-btn);
  border: 1rpx solid var(--c-line-strong);
  color: var(--c-ink-2);
  font-size: var(--t-body);
  margin: 0 12rpx;
}

.eb-dark {
  border-color: var(--c-brand);
  background: var(--c-brand);
  /* ★ 墨字压橙底 = 5.98:1；白字只有 2.74:1，不达标 */
  color: var(--c-ink);
  font-weight: 600;
}

/* ---- 主按钮 ----
   ★ 两处改动：胶囊 → 直角（--r-btn）；白字 → 墨字（对比度 2.74:1 → 5.98:1）。
     一屏最多出现一个。 */
.btn-primary {
  background: var(--c-brand);
  color: var(--c-ink);
  border-radius: var(--r-btn);
  font-size: var(--t-h2);
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
}

.btn-primary.disabled {
  background: var(--c-line-strong);
  color: var(--c-ink-3);
}

/* ---- 输入框占位文字 ----
   微信默认的 placeholder 是很浅的灰且各平台不一致，统一压到最淡那一档。
   用 placeholder-class="ph" 引用（加菜页的两个 input 和一个 textarea）。 */
.ph {
  color: var(--c-ink-4);
}

/* ---- 底部安全区占位 ---- */
.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
