/* ===== 全局样式 ===== */

/*
 * 【设计令牌】
 * ---------------------------------------------------------------------------
 * 这一层是这次「美化」的核心。之前的问题是**整站没有系统**：
 *   - 6 种野生灰（#5A6070 / #8A8F99 / #9AA0AB / #A6ABB5 / #3A3F4A / #6B7280）
 *   - 15 种字号（21,22,23,…,44 几乎每个整数都用过）
 *   - 所有圆角一律 20rpx，无论层级
 *   - 每个区块都是一模一样的白圆角卡片
 * 这四件事合起来，就是「一眼看出是模板」的真正来源 —— 不是缺装饰，是缺纪律。
 *
 * 下面把它们收敛成有限的几档。以后改配色 / 改字号，只改这一块。
 *
 * ★ 注意：--c-brand 必须和 app.json 的 tabBar.selectedColor、
 *   以及 .workbuddy/tools/gen-tab-icons.py 里的颜色常量保持一致，
 *   改它要同步三处并重跑图标脚本。
 */
page {
  /* ---- 颜色：主色 ---- */
  --c-brand:        #FF7043;   /* 番茄橙，全站唯一的重音 */
  --c-brand-deep:   #E85A2C;   /* 按下 / 加深 */
  --c-brand-tint:   #FFF1EC;   /* 主色淡底：标签、徽章 */
  --c-brand-line:   #FFDCCF;   /* 主色淡边 */

  /* ---- 颜色：底与面 ----
     底色原来是冷灰 #F5F6F8。菜品照片挂在冷灰上会发青、显得不新鲜，
     换成色度极低的暖白，照片里的食物才「熟」。 */
  --c-bg:           #F6F5F3;
  --c-surface:      #FFFFFF;
  --c-surface-sunk: #F1F0EE;   /* 下沉面：tab 轨道、缩略图占位 */

  /* ---- 颜色：文字（原来是 6 种野生灰，收敛成 4 档）---- */
  --c-ink:          #1C1E21;   /* 主文字 */
  --c-ink-2:        #585F6B;   /* 次要 */
  --c-ink-3:        #8A8F99;   /* 弱（和 tabBar 图标灰保持一致，别改） */
  --c-ink-4:        #B0B6C0;   /* 最淡：占位、脚注 */

  /* ---- 颜色：线与状态 ---- */
  --c-line:         #E9EAEC;
  --c-line-strong:  #DCDEE1;
  --c-ok:           #2E9E5B;   /* 在线 / 已同步（原来 #34C759 和 #34A853 两个绿，合并） */
  --c-danger:       #D9483B;   /* 原来 #E0483A */
  --c-danger-tint:  #FDF0EE;   /* 危险操作的淡底：目前只有「解散房间」用 */

  /* ---- 圆角层级（原来一律 20rpx，没有层级）---- */
  --r-pill:  999rpx;   /* 胶囊：按钮、标签 */
  --r-panel: 28rpx;    /* 大面板：底部弹层 */
  --r-card:  20rpx;    /* 容器卡片 */
  --r-item:  16rpx;    /* 卡内元素：缩略图、输入框 */

  /* ---- 字号（原来 15 种，收敛成 7 档）---- */
  /* --t-hero 是唯一的例外：只给「摇一摇」滚动结果那一行用。
     全站把「大胆」花在这一处，其他所有地方都安静。 */
  --t-hero:    64rpx;  /* 只给摇一摇的滚动结果 */
  --t-display: 44rpx;  /* 一页只允许出现一次 */
  --t-big:     56rpx;  /* 只给「要念给别人听」的短码：房间码 */
  --t-h1:      36rpx;
  --t-h2:      32rpx;
  --t-body:    29rpx;
  --t-sub:     26rpx;
  --t-cap:     23rpx;
  --t-tag:     21rpx;

  background: var(--c-bg);
  color: var(--c-ink);
  font-size: var(--t-body);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* ---- 分类横向筛选条 ---- */
.cat-bar {
  white-space: nowrap;
  background: var(--c-surface);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.cat-item {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-left: 20rpx;
  font-size: var(--t-cap);
  color: var(--c-ink-2);
  background: var(--c-surface-sunk);
  border-radius: var(--r-pill);
  transition: all .15s;
}

.cat-item:last-child {
  margin-right: 20rpx;
}

.cat-item.on {
  color: #FFFFFF;
  background: var(--c-brand);
  font-weight: 600;
}

/* ---- 通用卡片 ---- */
.card {
  background: var(--c-surface);
  border-radius: var(--r-card);
  overflow: hidden;
}

/* ---- 空状态 ---- */
.empty {
  padding: 180rpx 60rpx;
  text-align: center;
}

.empty-title {
  font-size: var(--t-h2);
  color: var(--c-ink-2);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: var(--t-sub);
  color: var(--c-ink-3);
  line-height: 1.7;
}

/* 空状态里的按钮（菜单页、收藏页共用，所以放全局） */
.empty-btns {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}

.eb {
  padding: 20rpx 50rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand-tint);
  color: var(--c-brand);
  font-size: var(--t-body);
  font-weight: 600;
  margin: 0 14rpx;
}

.eb-dark {
  background: var(--c-brand);
  color: #FFFFFF;
}

/* ---- 分区标题 ----
   去掉原来的 letter-spacing: 2rpx —— 中文在小字号下加字距，
   配合「每段都顶一个小标签」是模板感的来源之一。 */
.section-title {
  padding: 28rpx 30rpx 14rpx;
  font-size: var(--t-sub);
  color: var(--c-ink-3);
}

/* ---- 主按钮 ---- */
.btn-primary {
  background: var(--c-brand);
  color: #FFFFFF;
  border-radius: var(--r-pill);
  font-size: var(--t-h2);
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}

.btn-primary.disabled {
  background: var(--c-line-strong);
  color: #FFFFFF;
}

/* ---- 底部安全区占位 ---- */
.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
